# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PeakCut AI Provider Settings (optional overrides; defaults to Gemini using GEMINI_API_KEY)
PEAKCUT_AI_PROVIDER="gemini"
PEAKCUT_AI_MODELS="gemini-2.5-flash"
PEAKCUT_AI_KEY=""
PEAKCUT_AI_BASE_URL=""

# PeakCut Server & Accounts Settings
PEAKCUT_ACCOUNTS="0"
PEAKCUT_VERIFY_EMAIL="0"
PEAKCUT_PUBLIC_URL=""
PEAKCUT_DATA="./data"
PEAKCUT_MAX_UPLOAD_MB="500"
PEAKCUT_UPLOAD_PART_MB="25"
PEAKCUT_MAX_JOBS_PER_USER="5"
PEAKCUT_MAX_CREATORS="25"
PEAKCUT_MAX_USER_GB="10"
PEAKCUT_LEGAL_NAME="PeakCut"
PEAKCUT_LEGAL_COUNTRY=""
PEAKCUT_CONTACT_EMAIL=""

# Optional Social Posting OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
PEAKCUT_IG_APP_ID=""
PEAKCUT_IG_APP_SECRET=""
PEAKCUT_TIKTOK_CLIENT_KEY=""
PEAKCUT_TIKTOK_CLIENT_SECRET=""
